---
const { services = [] } = Astro.props;

const statusConfig = {
  online: { label: 'Online', color: '#10B981', icon: '🟢' },
  degraded: { label: 'Degradado', color: '#F59E0B', icon: '🟡' },
  offline: { label: 'Offline', color: '#EF4444', icon: '🔴' }
};
---

<div style="display: flex; flex-direction: column; gap: 8px; margin: 16px 0;">
  {services.map((s) => {
    const conf = statusConfig[s.status] || statusConfig.online;
    return (
      <div style="display: flex; justify-content: space-between; align-items: center; background: #1e1f22; border: 1px solid #35363c; padding: 12px 16px; border-radius: 8px;">
        <span style="font-weight: 600; color: #f2f3f5;">{s.name}</span>
        <span style={`color: ${conf.color}; font-weight: bold; font-size: 0.9rem; border: 1px solid ${conf.color}40; background: ${conf.color}15; padding: 4px 10px; border-radius: 6px;`}>
          {conf.icon} {conf.label}
        </span>
      </div>
    );
  })}
</div>
