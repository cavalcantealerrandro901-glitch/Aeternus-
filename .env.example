TOKEN=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=https://seu-app.onrender.com/auth/discord/callback

# ── MongoDB (obrigatório no Render / produção) ─────────────────────────────
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/aeternus?retryWrites=true&w=majority
MONGO_URI=

# Encerra o bot se o Mongo falhar (recomendado no Render)
STORE_REQUIRE_MONGO=1

# Também grava data/*.json (só útil em dev com disco persistente)
# STORE_LOCAL=1

# Debounce do flush Mongo em ms (padrão 250)
# STORE_FLUSH_MS=250

PORT=10000
OWNER_ID=
SUPPORT_SERVER_URL=
INSTAGRAM_URL=https://instagram.com/seu_usuario
TWITTER_URL=
YOUTUBE_URL=
TIKTOK_URL=

# Música (Shoukaku / Lavalink v4) — vários nodes separados por ;
# Formato: nome|host:porta|senha|secure
LAVALINK_NODES=
# Loritta API (câmbio Éter ↔ Sonhos)
LORITTA_API_TOKEN=
LORITTA_SONHOS_PER_ETER=10

# ── J.A.R.V.I.S. / Multi-IA (opcional — cascata até um responder) ───────────
# Ordem: Groq → OpenAI → Gemini → OpenRouter → HuggingFace → Pollinations (sem chave)
# NUNCA commit chaves reais. Só preencha no Render Environment ou .env local.

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# ou GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_REFERER=https://seu-app.onrender.com

HF_TOKEN=
# ou HUGGINGFACE_API_KEY=
# HF_MODEL=HuggingFaceH4/zephyr-7b-beta
