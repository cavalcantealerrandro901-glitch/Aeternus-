TOKEN=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=https://seu-app.onrender.com/auth/discord/callback

OWNER_ID=
EDITOR_OWNER_ID=

# ID numérico do cargo anti-roubo (configurado no Render)
ANTI_ROB_ROLE_ID=

MONGO_URI=
STORE_REQUIRE_MONGO=1
PORT=10000

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REPAIR_MODEL=

# OpenAI — diagnóstico complementar de erros (opcional)
OPENAI_API_KEY=
OPENAI_REPAIR_MODEL=gpt-4.1-mini

# Token GitHub com Contents: Read and write (guardar apenas no ambiente do host)
GITHUB_TOKEN=
GITHUB_OWNER=cavalcantealerrandro901-glitch
GITHUB_REPO=cavalcantealerrandro901-glitch/Aeternus-
GITHUB_BRANCH=main
AETERNUS_REPOS=

# Reparo automático de código (desativado por padrão; requer validação + backup + GitHub)
AI_AUTO_REPAIR=false
AI_AUTO_REPAIR_REQUIRE_GITHUB=true

# Central de reparo no Discord: configure IDs no Render (não nomes)
AUTO_REPAIR_GUILD_ID=
AUTO_REPAIR_CHANNEL_ID=
AUTO_REPAIR_ROLE_ID=

# Lavalink (música) — formato: nome|host:porta|senha|secure
# Sem aspas na senha. Secure=true para porta 443.
LAVALINK_NODES=serenetia|lavalinkv4.serenetia.com:443|https://seretia.link/discord|true

PANEL_SECRET=
