<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Painel Aeternus</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #0f172a; color: white; display: flex; justify-content: center; padding: 20px; }
        .container { width: 100%; max-width: 650px; background: #1e293b; padding: 20px; border-radius: 15px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
        h1 { color: #38bdf8; text-align: center; }
        .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .card { background: #334155; padding: 15px; border-radius: 10px; text-align: center; }
        .terminal { background: #000; color: #00ff00; padding: 10px; border-radius: 8px; font-family: monospace; height: 120px; overflow-y: auto; text-align: left; font-size: 0.85em; margin-bottom: 20px; }
        .log-item { margin-bottom: 4px; }
        .box { background: #334155; padding: 15px; border-radius: 10px; margin-bottom: 15px; }
        input, textarea { padding: 8px; border-radius: 5px; border: 1px solid #475569; background: #0f172a; color: white; width: calc(100% - 20px); margin-bottom: 10px; }
        textarea { height: 80px; resize: vertical; font-family: monospace; }
        button { padding: 8px 15px; border-radius: 5px; border: none; background: #38bdf8; color: #0f172a; font-weight: bold; cursor: pointer; }
        .btn-danger { background: #ef4444; color: white; }
        .btn-warning { background: #f59e0b; color: white; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Painel Aeternus</h1>
        <div class="stat-grid">
            <div class="card">Servidores<br><strong><%= guildCount %></strong></div>
            <div class="card">RAM<br><strong><%= memory %> MB</strong></div>
        </div>

        <div class="box">
            <h3>⚙️ Modo de Manutenção</h3>
            <p>Status atual: <strong><%= maintenance ? '🔴 ATIVADO' : '🟢 DESATIVADO' %></strong></p>
            <form action="/toggle-maintenance" method="POST">
                <button type="submit" class="btn-warning"><%= maintenance ? 'Desativar Manutenção' : 'Ativar Manutenção' %></button>
            </form>
        </div>

        <div class="box">
            <h3>🔑 Variáveis de Ambiente (.env)</h3>
            <form action="/save-env" method="POST">
                <textarea name="envData"><%= envContent %></textarea>
                <button type="submit">Salvar Variáveis</button>
            </form>
        </div>

        <div class="box">
            <h3>📂 Configuração do Repositório</h3>
            <form action="/update-repo" method="POST">
                <input type="text" name="repoUrl" placeholder="https://github.com/usuario/repo.git" required>
                <button type="submit">Atualizar Link</button>
            </form>
        </div>

        <h3>Logs do Sistema & Auto-Deploy</h3>
        <div class="terminal">
            <% if (logs.length === 0) { %>
                <div>Aguardando eventos...</div>
            <% } else { %>
                <% logs.forEach(log => { %>
                    <div class="log-item">[<%= log.timestamp %>] [<%= log.type %>]: <%= log.message %></div>
                <% }) %>
            <% } %>
        </div>

        <div class="box" style="border: 1px solid #ef4444;">
            <h3>Controle Administrativo</h3>
            <form action="/restart" method="POST">
                <input type="password" name="password" placeholder="Senha Admin" required style="width: 150px; display: inline-block;">
                <button type="submit" class="btn-danger">Reiniciar Bot</button>
            </form>
        </div>
    </div>
</body>
</html>
